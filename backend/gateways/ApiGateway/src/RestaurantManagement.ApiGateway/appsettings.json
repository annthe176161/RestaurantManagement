{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "branch-route": {
        "ClusterId": "branch-cluster",
        "Match": {
          "Path": "/api/branches/{**catch-all}"
        }
      },
      "menu-route": {
        "ClusterId": "menu-cluster",
        "Match": {
          "Path": "/api/menu-categories/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "branch-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "menu-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
